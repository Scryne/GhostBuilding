# ═══════════════════════════════════════════════════════════════════════════
# GhostBuilding — Environment Configuration
# Copy this file to .env and fill in the values.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database Configuration ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ghostbuilding

# ── Redis Configuration ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Backend Configuration ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ghostbuilding
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
ENVIRONMENT=dev
DEBUG=false

# ── Frontend Configuration ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Imagery sources ───────────────────────────────────────────────────────
# Esri World Imagery, Esri Wayback and IGN Géoplateforme (France only) need no key;
# attribution is shown in the UI. MapTiler Satellite is the second worldwide source for
# cross-provider comparison. Without it a scan outside France has only one source and fails
# with "at least two imagery sources required". Free key: https://cloud.maptiler.com/account/keys/
MAPTILER_API_KEY=
# The same key (restrict it to your domain) enables the MapTiler basemap in the browser.
NEXT_PUBLIC_MAPLIBRE_TOKEN=
# Optional: YOLO weights trained for building footprints in aerial imagery. Without it the
# OSM ↔ imagery comparison (ghost building / hidden structure) stays off; a general COCO
# model cannot recognise buildings from above.
BUILDING_DETECTOR_WEIGHTS=

# ── Public URLs ───────────────────────────────────────────────────────────
# Canonical/OG base URL of the web app, and the API URL seen from the frontend container.
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_INTERNAL_URL=http://backend:8000/api/v1

# ── E-posta (SMTP) ────────────────────────────────────────────────────────
# E-posta doğrulama ve şifre sıfırlama bağlantıları bu sunucu üzerinden gönderilir.
# SMTP_HOST boşsa gönderim KAPALIDIR: uygulama çalışır, açılışta ve /api/v1/health'te
# "email: disabled" der, kayıt yanıtı bunu bildirir, şifre sıfırlama 503 döner.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Gönderen; boşsa SMTP_USERNAME kullanılır. Ör. GhostBuilding <noreply@alanadiniz>
SMTP_FROM=
# starttls (587) | ssl (465) | none (yalnız yerel test sunucusu; şifresiz)
SMTP_SECURITY=starttls
# E-postadaki bağlantıların kökü: kullanıcının açtığı ön yüz adresi (canlıda https://...)
FRONTEND_URL=http://localhost:3000

# ── Sentry Error Tracking ─────────────────────────────────────────────────
# Get your DSN from https://sentry.io → Project Settings → Client Keys (DSN)
# Use separate projects for dev/staging/prod
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Frontend Sentry DSN (public — safe to expose)
NEXT_PUBLIC_SENTRY_DSN=

# ── Monitoring ─────────────────────────────────────────────────────────────
ENABLE_PROMETHEUS=true
GRAFANA_ADMIN_PASSWORD=ghostbuilding_admin
